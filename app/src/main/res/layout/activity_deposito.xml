<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_gray"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_background"
        android:padding="20dp"
        android:elevation="4dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saldo Atual em R$"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvSaldoAtualDeposito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 0,00"
            android:textSize="26sp"
            android:textColor="@color/primary_dark"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Valor para Depósito (R$)"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etValorDeposito"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/card_background"
        android:hint="@string/hint_valor_deposito"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:textSize="16sp"
        android:elevation="2dp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnConfirmarDeposito"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/btn_confirmar_deposito"
        android:textSize="16sp"
        android:backgroundTint="@color/accent"
        android:textColor="@color/white" />

</LinearLayout>

