<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_moeda_origem"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spMoedaOrigem"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/card_background"
            android:elevation="2dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvSaldoOrigemDisponivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saldo disponível: 0.00"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_moeda_destino"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spMoedaDestino"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/card_background"
            android:elevation="2dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvSaldoDestinoDisponivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saldo disponível: 0.00"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valor a ser Convertido (Moeda Origem)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etValorConversao"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/card_background"
            android:hint="@string/hint_valor_conversao"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textSize="16sp"
            android:elevation="2dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnExecutarConversao"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/btn_converter_acao"
            android:textSize="16sp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/white"
            android:layout_marginBottom="20dp" />

        <!-- ProgressBar para requisição da API -->
        <ProgressBar
            android:id="@+id/progressBarConversao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <!-- Card de Resultado da Conversão -->
        <LinearLayout
            android:id="@+id/layoutResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_background"
            android:padding="16dp"
            android:elevation="3dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resultado da Transação:"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvResultadoConversao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valor convertido: $ 0.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/success"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvCotacaoUtilizada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Taxa de câmbio: 1.00"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

